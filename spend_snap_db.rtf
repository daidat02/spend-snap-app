\f0\fs24 \cf0 -- B\uc0\u7853 t extension \u273 \u7875  t\u7921  \u273 \u7897 ng sinh UUID v4\
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";\
\
-- ========================================================\
-- 1. MODULE USER & AUTHENTICATION\
-- ========================================================\
\
CREATE TABLE users (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    username VARCHAR(50) UNIQUE NOT NULL,\
    email VARCHAR(100) UNIQUE NOT NULL,\
    password_hash VARCHAR(255) NOT NULL,\
    full_name VARCHAR(100),\
    avatar_url TEXT,\
    bio VARCHAR(255),\
    is_active BOOLEAN DEFAULT TRUE,\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    deleted_at TIMESTAMP WITH TIME ZONE\
);\
\
-- Qu\uc0\u7843 n l\'fd Device Tokens \u273 \u7875  \u273 \u7849 y Push Notification (Widget/Chat)\
CREATE TABLE user_devices (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\
    fcm_token TEXT NOT NULL,\
    device_type VARCHAR(20) NOT NULL, -- 'ios', 'android'\
    last_active_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    CONSTRAINT unique_user_device UNIQUE(user_id, fcm_token)\
);\
\
-- ========================================================\
-- 2. MODULE SOCIAL & FRIENDSHIPS\
-- ========================================================\
\
CREATE TABLE friendships (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    requester_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\
    addressee_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\
    status VARCHAR(20) NOT NULL DEFAULT 'pending', -- 'pending', 'accepted', 'rejected', 'blocked'\
    is_close_friend BOOLEAN DEFAULT FALSE,\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    CONSTRAINT unique_friend_request UNIQUE(requester_id, addressee_id),\
    CONSTRAINT chk_self_friend CHECK (requester_id <> addressee_id)\
);\
\
-- ========================================================\
-- 3. MODULE FINANCE CORE (V\'cd & DANH M\uc0\u7908 C & GIAO D\u7882 CH)\
-- ========================================================\
\
CREATE TABLE wallets (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\
    name VARCHAR(50) NOT NULL, -- 'Ti\uc0\u7873 n m\u7863 t', 'V\'ed MoMo', 'Vietcombank'\
    balance BIGINT NOT NULL DEFAULT 0, -- L\uc0\u432 u \u273 \u417 n v\u7883  nh\u7887  nh\u7845 t (VND)\
    currency VARCHAR(10) DEFAULT 'VND',\
    icon_url TEXT,\
    is_default BOOLEAN DEFAULT FALSE,\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\
);\
\
CREATE TABLE categories (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    user_id UUID REFERENCES users(id) ON DELETE CASCADE, -- NULL = Danh m\uc0\u7909 c h\u7879  th\u7889 ng\
    name VARCHAR(50) NOT NULL,\
    type VARCHAR(10) NOT NULL CHECK (type IN ('expense', 'income')),\
    icon VARCHAR(50),\
    color VARCHAR(20),\
    parent_id UUID REFERENCES categories(id) ON DELETE SET NULL,\
    is_system BOOLEAN DEFAULT FALSE,\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\
);\
\
-- B\uc0\u7843 ng Giao d\u7883 ch (Thu\u7847 n t\'e0i ch\'ednh, \u273 \u7897 c l\u7853 p v\u7899 i \u7842 nh)\
CREATE TABLE transactions (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\
    wallet_id UUID NOT NULL REFERENCES wallets(id) ON DELETE CASCADE,\
    category_id UUID NOT NULL REFERENCES categories(id) ON DELETE RESTRICT,\
    amount BIGINT NOT NULL CHECK (amount > 0),\
    type VARCHAR(10) NOT NULL DEFAULT 'expense', -- 'expense', 'income'\
    note TEXT,\
    transaction_date TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    deleted_at TIMESTAMP WITH TIME ZONE\
);\
\
-- ========================================================\
-- 4. MODULE LOCKET POSTS & INTERACTION (B\'c0I \uc0\u272 \u258 NG & T\u431 \u416 NG T\'c1C)\
-- ========================================================\
\
-- B\uc0\u7843 ng B\'e0i \u273 \u259 ng Kho\u7843 nh kh\u7855 c (C\'f3 th\u7875  g\u7855 n ho\u7863 c kh\'f4ng g\u7855 n Giao d\u7883 ch)\
CREATE TABLE posts (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\
    image_url TEXT NOT NULL, -- B\uc0\u7855 t bu\u7897 c ph\u7843 i c\'f3 \u7843 nh\
    caption TEXT,\
    visibility VARCHAR(20) NOT NULL DEFAULT 'friends', -- 'private', 'friends', 'close_friends', 'public'\
    location_name VARCHAR(255),\
    transaction_id UUID REFERENCES transactions(id) ON DELETE SET NULL, -- T\'d9Y CH\uc0\u7884 N: Li\'ean k\u7871 t t\u7899 i giao d\u7883 ch\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    deleted_at TIMESTAMP WITH TIME ZONE\
);\
\
CREATE TABLE post_reactions (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    post_id UUID NOT NULL REFERENCES posts(id) ON DELETE CASCADE,\
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\
    emoji VARCHAR(10) NOT NULL, -- '\uc0\u10084 \u65039 ', '\u55357 \u56613 ', '\u55357 \u56878 ', '\u55357 \u56504 '\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    CONSTRAINT unique_user_post_reaction UNIQUE(post_id, user_id, emoji)\
);\
\
CREATE TABLE comments (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    post_id UUID NOT NULL REFERENCES posts(id) ON DELETE CASCADE,\
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\
    parent_id UUID REFERENCES comments(id) ON DELETE CASCADE, -- H\uc0\u7895  tr\u7907  Reply\
    content TEXT NOT NULL,\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\
);\
\
-- ========================================================\
-- 5. MODULE SPLIT BILL (CHIA TI\uc0\u7872 N NH\'d3M)\
-- ========================================================\
\
CREATE TABLE groups (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    name VARCHAR(100) NOT NULL,\
    created_by UUID NOT NULL REFERENCES users(id),\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\
);\
\
CREATE TABLE group_members (\
    group_id UUID NOT NULL REFERENCES groups(id) ON DELETE CASCADE,\
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,\
    role VARCHAR(20) DEFAULT 'member', -- 'admin', 'member'\
    joined_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\
    PRIMARY KEY (group_id, user_id)\
);\
\
CREATE TABLE transaction_splits (\
    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\
    transaction_id UUID NOT NULL REFERENCES transactions(id) ON DELETE CASCADE,\
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE, -- Ng\uc0\u432 \u7901 i c\u7847 n tr\u7843  l\u7841 i ti\u7873 n\
    split_amount BIGINT NOT NULL,\
    is_paid BOOLEAN DEFAULT FALSE,\
    paid_at TIMESTAMP WITH TIME ZONE,\
    created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\
);\
\
-- T\uc0\u7889 i \u432 u l\u7845 y Feed Locket (L\u7885 c theo user_id, quy\u7873 n ri\'eang t\u432  v\'e0 s\u7855 p x\u7871 p th\u7901 i gian)\
CREATE INDEX idx_posts_feed ON posts (user_id, visibility, created_at DESC) WHERE deleted_at IS NULL;\
\
-- T\uc0\u7889 i \u432 u ki\u7875 m tra quan h\u7879  b\u7841 n b\'e8 (\u272 \u7875  ch\u7863 n/cho ph\'e9p xem Feed)\
CREATE INDEX idx_friendships_lookup ON friendships (requester_id, addressee_id, status);\
\
-- T\uc0\u7889 i \u432 u load b\'ecnh lu\u7853 n v\'e0 th\u7843  tim cho 1 b\u7913 c \u7843 nh c\u7909  th\u7875 \
CREATE INDEX idx_comments_post ON comments (post_id, created_at ASC);\
CREATE INDEX idx_reactions_post ON post_reactions (post_id);\
\
-- T\uc0\u7889 i \u432 u load l\u7883 ch s\u7917  giao d\u7883 ch c\'e1 nh\'e2n v\'e0 b\'e1o c\'e1o th\u7889 ng k\'ea\
CREATE INDEX idx_transactions_user_date ON transactions (user_id, transaction_date DESC) WHERE deleted_at IS NULL;\
\
}